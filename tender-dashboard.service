[Unit]
Description=Tender Dashboard Flask Server
After=network.target postgresql.service

[Service]
Type=simple
User=Amaraa
WorkingDirectory=/home/Amaraa/B2G/tender-dashboard
EnvironmentFile=/home/Amaraa/B2G/tender-dashboard/.env
ExecStart=/home/Amaraa/B2G/tender-dashboard/venv/bin/python /home/Amaraa/B2G/tender-dashboard/tender_app.py
Restart=always
RestartSec=5
StandardOutput=append:/home/Amaraa/B2G/tender-dashboard/logs/server.log
StandardError=append:/home/Amaraa/B2G/tender-dashboard/logs/server.log

[Install]
WantedBy=multi-user.target
