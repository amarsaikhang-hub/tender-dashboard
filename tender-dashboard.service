[Unit]
Description=Tender Dashboard Flask Server
After=network.target postgresql.service

[Service]
Type=simple
User=amarsaikhan
WorkingDirectory=/home/amarsaikhan/Downloads/tender-dashboard
EnvironmentFile=/home/amarsaikhan/Downloads/tender-dashboard/.env
ExecStart=/home/amarsaikhan/Downloads/tender-dashboard/venv/bin/python /home/amarsaikhan/Downloads/tender-dashboard/tender_app.py
Restart=always
RestartSec=5
StandardOutput=append:/home/amarsaikhan/Downloads/tender-dashboard/logs/server.log
StandardError=append:/home/amarsaikhan/Downloads/tender-dashboard/logs/server.log

[Install]
WantedBy=multi-user.target
