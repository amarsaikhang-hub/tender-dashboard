
[Unit]
Description=Company Resources Flask Server
After=network.target postgresql.service

[Service]
Type=simple
User=Amaraa
WorkingDirectory=/home/Amaraa/B2G/company-resources
EnvironmentFile=/home/Amaraa/B2G/company-resources/.env
ExecStart=/home/Amaraa/B2G/company-resources/venv/bin/python /home/Amaraa/B2G/company-resources/app.py
Restart=always
RestartSec=5
StandardOutput=append:/home/Amaraa/B2G/company-resources/logs/server.log
StandardError=append:/home/Amaraa/B2G/company-resources/logs/server.log

[Install]
WantedBy=multi-user.target
