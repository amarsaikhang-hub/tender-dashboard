[Unit]
Description=Teams Tender Notification
After=network.target postgresql.service

[Service]
Type=oneshot
User=Amaraa
WorkingDirectory=/home/Amaraa/B2G/tender-dashboard
EnvironmentFile=/home/Amaraa/B2G/tender-dashboard/.env
ExecStart=/home/Amaraa/B2G/tender-dashboard/venv/bin/python /home/Amaraa/B2G/tender-dashboard/teams_notify.py
StandardOutput=append:/home/Amaraa/B2G/tender-dashboard/logs/teams_notify.log
StandardError=append:/home/Amaraa/B2G/tender-dashboard/logs/teams_notify.log
