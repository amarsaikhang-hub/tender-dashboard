[Unit]
Description=Teams Tender Notification
After=network.target postgresql.service

[Service]
Type=oneshot
User=amarsaikhan
WorkingDirectory=/home/amarsaikhan/Downloads/tender-dashboard
EnvironmentFile=/home/amarsaikhan/Downloads/tender-dashboard/.env
ExecStart=/home/amarsaikhan/Downloads/tender-dashboard/venv/bin/python /home/amarsaikhan/Downloads/tender-dashboard/teams_notify.py
StandardOutput=append:/home/amarsaikhan/Downloads/tender-dashboard/logs/teams_notify.log
StandardError=append:/home/amarsaikhan/Downloads/tender-dashboard/logs/teams_notify.log
