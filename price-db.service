[Unit]
Description=Price DB Flask Server
After=network.target postgresql.service

[Service]
Type=simple
User=Amaraa
WorkingDirectory=/home/Amaraa/B2G/price-db
EnvironmentFile=/home/Amaraa/B2G/price-db/.env
ExecStart=/home/Amaraa/B2G/price-db/venv/bin/python /home/Amaraa/B2G/price-db/app.py
Restart=always
RestartSec=5
StandardOutput=append:/home/Amaraa/B2G/price-db/logs/server.log
StandardError=append:/home/Amaraa/B2G/price-db/logs/server.log

[Install]
WantedBy=multi-user.target
